<?xml version="1.0" ?>
<sdf version="1.10">
<model name="sorter_hopper">
    <static>true</static>

    <!-- 1. ПОДВИЖНАЯ ЛЕНТА НАКОПИТЕЛЯ (Высота 0.1м) -->
    <link name="belt_link">
        <pose>0.75 0 0 0 0 0</pose>
        
        <visual name="belt_visual">
            <geometry>
                <box><size>1.5 1.0 0.1</size></box>
            </geometry>
            <!-- МАТЕРИАЛ ИЗМЕНЕН: Теперь точно такой же, как у конвейера -->
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
            </material>
        </visual>
        
        <collision name="belt_collision">
            <geometry>
                <box><size>1.5 1.0 0.09</size></box>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>10.0</mu>
                        <mu2>10.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>100000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </link>

    <!-- 2. НЕПОДВИЖНЫЕ БОРТИКИ И НОЖКИ -->
    <link name="walls_link">
        <pose>0 0 0 0 0 0</pose>

        <!-- ЗАДНЯЯ СТЕНКА -->
        <visual name="back_wall_visual">
            <pose>0 0 0.1 0 0 0</pose>
            <geometry><box><size>0.05 1.1 0.1</size></box></geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="back_wall_collision">
            <pose>0 0 0.1 0 0 0</pose>
            <geometry><box><size>0.05 1.1 0.1</size></box></geometry>
        </collision>

        <!-- ЛЕВАЯ СТЕНКА -->
        <visual name="left_wall_visual">
            <pose>0.75 0.525 0.1 0 0 0</pose>
            <geometry><box><size>1.5 0.05 0.1</size></box></geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="left_wall_collision">
            <pose>0.75 0.525 0.1 0 0 0</pose>
            <geometry><box><size>1.5 0.05 0.1</size></box></geometry>
        </collision>

        <!-- ПРАВАЯ СТЕНКА -->
        <visual name="right_wall_visual">
            <pose>0.75 -0.525 0.1 0 0 0</pose>
            <geometry><box><size>1.5 0.05 0.1</size></box></geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="right_wall_collision">
            <pose>0.75 -0.525 0.1 0 0 0</pose>
            <geometry><box><size>1.5 0.05 0.1</size></box></geometry>
        </collision>

        <!-- ==================== НОВЫЕ ПЕРЕДНИЕ СТЕНКИ С ПРОЕМОМ ==================== -->
        <!-- Расположены на X = 1.5. Проем по центру Y от -0.25 до 0.25 (ровно 0.5м) -->
        
        <!-- ПЕРЕДНЯЯ ЛЕВАЯ СТЕНКА -->
        <visual name="front_wall_left_visual">
            <!-- Сдвинута по Y на 0.4, длина увеличена до 0.3 -->
            <pose>1.5 0.4 0.1 0 0 0</pose>
            <geometry><box><size>0.05 0.3 0.1</size></box></geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="front_wall_left_collision">
            <pose>1.5 0.4 0.1 0 0 0</pose>
            <geometry><box><size>0.05 0.3 0.1</size></box></geometry>
        </collision>

        <!-- ПЕРЕДНЯЯ ПРАВАЯ СТЕНКА -->
        <visual name="front_wall_right_visual">
            <!-- Сдвинута по Y на -0.4, длина увеличена до 0.3 -->
            <pose>1.5 -0.4 0.1 0 0 0</pose>
            <geometry><box><size>0.05 0.3 0.1</size></box></geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="front_wall_right_collision">
            <pose>1.5 -0.4 0.1 0 0 0</pose>
            <geometry><box><size>0.05 0.3 0.1</size></box></geometry>
        </collision>


        <!-- ==================== НОЖКИ НАКОПИТЕЛЯ ==================== -->
        <!-- ЗАДНЯЯ ЛЕВАЯ НОЖКА -->
        <visual name="leg_back_left_visual">
            <pose>0.05 0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_back_left_collision">
            <pose>0.05 0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>

        <!-- ЗАДНЯЯ ПРАВАЯ НОЖКА -->
        <visual name="leg_back_right_visual">
            <pose>0.05 -0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_back_right_collision">
            <pose>0.05 -0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>

        <!-- ПЕРЕДНЯЯ ЛЕВАЯ НОЖКА -->
        <visual name="leg_front_left_visual">
            <pose>1.45 0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_front_left_collision">
            <pose>1.45 0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>

        <!-- ПЕРЕДНЯЯ ПРАВАЯ НОЖКА -->
        <visual name="leg_front_right_visual">
            <pose>1.45 -0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_front_right_collision">
            <pose>1.45 -0.48 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>
    </link>

    <!-- ПЛАГИН ДВИЖЕНИЯ -->
    <plugin
        filename="gz-sim-track-controller-system"
        name="gz::sim::systems::TrackController">
        <link>belt_link</link>
        <min_velocity>-10.0</min_velocity>
        <max_velocity>10.0</max_velocity>
        <velocity_topic>/hopper_speed</velocity_topic> 
    </plugin>
</model>
</sdf>

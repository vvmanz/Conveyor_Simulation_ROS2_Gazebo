<?xml version="1.0" ?>
<sdf version="1.10">
<model name="inclined_conveyor_d">
    <static>true</static>
    
    <!-- Главная наклонная лента (Длина 0.75м) -->
    <!-- Угол тангажа 0.13364 радиан дает подъем ровно на 10 см на длине 75 см -->
    <link name="belt_link">
        <pose>0 0 0 0 0.13364 0</pose>
        <visual name="belt_visual">
            <geometry>
                <box><size>0.75 0.5 0.1</size></box>
            </geometry>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
            </material>
        </visual>
        <collision name="belt_collision">
            <geometry>
                <box><size>0.75 0.5 0.1</size></box>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>10.0</mu>
                        <mu2>10.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1000000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </link>

    <!-- Единственный правый бортик и опорная структура -->
    <link name="frame_link">
        <pose>0 0 0 0 0.13364 0</pose>

        <!-- ТОЛЬКО ОДИН БОРТИК (Правый, вдоль оси X) -->
        <visual name="guard_rail_right_visual">
            <!-- Сдвинут по Y на правый край ленты (-0.25) - половина своей ширины (0.015) -->
            <pose>0 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.75 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_right_collision">
            <pose>0 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.75 0.03 0.15</size></box>
            </geometry>
        </collision>

        <!-- ОПОРНЫЕ НОЖКИ (Компенсируют наклон относительно горизонтальной земли) -->
        <!-- Задняя левая ножка (Низкая часть конвейера, X = -0.325) -->
        <visual name="leg_rear_left_visual">
            <pose>-0.325 0.23 -0.32 0 -0.13364 0</pose>
            <geometry>
                <cylinder><radius>0.02</radius><length>0.55</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_rear_left_collision">
            <pose>-0.325 0.23 -0.32 0 -0.13364 0</pose>
            <geometry><cylinder><radius>0.02</radius><length>0.55</length></cylinder></geometry>
        </collision>

        <!-- Задняя правая ножка (Низкая часть, X = -0.325) -->
        <visual name="leg_rear_right_visual">
            <pose>-0.325 -0.23 -0.32 0 -0.13364 0</pose>
            <geometry>
                <cylinder><radius>0.02</radius><length>0.55</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_rear_right_collision">
            <pose>-0.325 -0.23 -0.32 0 -0.13364 0</pose>
            <geometry><cylinder><radius>0.02</radius><length>0.55</length></cylinder></geometry>
        </collision>

        <!-- Передняя левая ножка (Высокая часть конвейера, X = 0.325) -->
        <!-- Стала длиннее на 10 см, чтобы компенсировать подъем рамы -->
        <visual name="leg_front_left_visual">
            <pose>0.325 0.23 -0.37 0 -0.13364 0</pose>
            <geometry>
                <cylinder><radius>0.02</radius><length>0.65</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_front_left_collision">
            <pose>0.325 0.23 -0.37 0 -0.13364 0</pose>
            <geometry><cylinder><radius>0.02</radius><length>0.65</length></cylinder></geometry>
        </collision>

        <!-- Передняя правая ножка (Высокая часть, X = 0.325) -->
        <visual name="leg_front_right_visual">
            <pose>0.325 -0.23 -0.37 0 -0.13364 0</pose>
            <geometry>
                <cylinder><radius>0.02</radius><length>0.65</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_front_right_collision">
            <pose>0.325 -0.23 -0.37 0 -0.13364 0</pose>
            <geometry><cylinder><radius>0.02</radius><length>0.65</length></cylinder></geometry>
        </collision>
    </link>

    <!-- Плагин управления движением наклонного трека -->
    <plugin
        filename="gz-sim-track-controller-system"
        name="gz::sim::systems::TrackController">
        <link>belt_link</link>
        <min_velocity>-10.0</min_velocity>
        <max_velocity>10.0</max_velocity>
        <velocity_topic>/inclined_conveyor_speed_d</velocity_topic> 
    </plugin>
</model>
</sdf>

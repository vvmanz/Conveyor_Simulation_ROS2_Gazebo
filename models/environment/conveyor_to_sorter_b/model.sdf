<?xml version="1.0" ?>
<sdf version="1.10">
<model name="conveyor_to_sorter_b">
    <static>true</static>
    
    <!-- Главная движущаяся лента (1.8м) -->
    <link name="belt_link">
        <visual name="belt_visual">
            <geometry>
                <box><size>1.8 0.5 0.1</size></box>
            </geometry>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
            </material>
        </visual>
        <collision name="belt_collision">
            <geometry>
                <box><size>1.8 0.5 0.1</size></box>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1000000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </link>

    <!-- Статичное основание: бортики, торцевая стенка и ножки -->
    <link name="frame_link">
        <!-- БОРТИК 1 (Левый, длина 1.3м, от X = -0.4 до X = 0.9) -->
        <visual name="guard_rail_left_visual">
            <pose>0.25 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>1.3 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_left_collision">
            <pose>0.25 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>1.3 0.03 0.15</size></box>
            </geometry>
        </collision>

        <!-- ТОРЦЕВАЯ ЗАДНЯЯ СТЕНКА (Перпендикулярна ходу ленты) -->
        <!-- Размеры: толщина 3 см (по оси X), ширина 56 см (по оси Y - перекрывает ленту и бортики), высота 15 см -->
        <!-- Стоит на самом краю ленты X = -0.9. Смещена по Y на 0.015, чтобы состыковаться с правым бортиком -->
        <visual name="back_wall_visual">
            <pose>-0.9175 0.0045 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.03 0.56 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="back_wall_collision">
            <pose>-0.9175 0.0045 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.03 0.56 0.15</size></box>
            </geometry>
        </collision>

        <!-- БОРТИК 2 (Правый, вдоль оси X - сплошной 1.8м) -->
        <visual name="guard_rail_right_visual">
            <pose>0 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>1.8 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_right_collision">
            <pose>0 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>1.8 0.03 0.15</size></box>
            </geometry>
        </collision>

        <!-- НОЖКА 1 (Передняя левая) -->
        <visual name="leg_fl_visual">
            <pose>0.75 0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder><radius>0.03</radius><length>0.6</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_fl_collision">
            <pose>0.75 0.23 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>

        <!-- НОЖКА 2 (Передняя правая) -->
        <visual name="leg_fr_visual">
            <pose>0.75 -0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder><radius>0.03</radius><length>0.6</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_fr_collision">
            <pose>0.75 -0.23 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>

        <!-- НОЖКА 3 (Задняя левая) -->
        <visual name="leg_bl_visual">
            <pose>-0.75 0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder><radius>0.03</radius><length>0.6</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_bl_collision">
            <pose>-0.75 0.23 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>

        <!-- НОЖКА 4 (Задняя правая) -->
        <visual name="leg_br_visual">
            <pose>-0.75 -0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder><radius>0.03</radius><length>0.6</length></cylinder>
            </geometry>
            <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="leg_br_collision">
            <pose>-0.75 -0.23 -0.35 0 0 0</pose>
            <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
        </collision>
    </link>

    <!-- Плагин управления треком -->
    <plugin
        filename="gz-sim-track-controller-system"
        name="gz::sim::systems::TrackController">
        <link>belt_link</link>
        <min_velocity>-10.0</min_velocity>
        <max_velocity>10.0</max_velocity>
        <velocity_topic>/conveyor_to_sorter_b_speed</velocity_topic> 
    </plugin>
</model>
</sdf>

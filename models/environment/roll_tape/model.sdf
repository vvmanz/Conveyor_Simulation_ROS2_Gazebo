<?xml version="1.0" ?>
<sdf version="1.10">
<model name="roll_tape">
    <static>true</static>
    
    <!-- Главная движущаяся лента (3.0м) -->
    <link name="belt_link">
        <visual name="belt_visual">
            <geometry>
                <box><size>3.0 0.5 0.1</size></box>
            </geometry>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
            </material>
        </visual>
        <collision name="belt_collision">
            <geometry>
                <box><size>3.0 0.5 0.1</size></box>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <kp>1000000.0</kp>
                        <kd>100.0</kd>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </link>

    <!-- Статичное основание: бортики и ножки -->
    <link name="frame_link">
        <!-- БОРТИК 1 (ЛЕВЫЙ — ВЫРЕЗЫ ПО 60 СМ) -->
        <!-- Вырез 1: от -1.1 до -0.5. Вырез 2: от 0.5 до 1.1 -->
        
        <!-- Левый бортик: Часть 1 (Задняя) -> Длина = 0.4м, Центр X = -1.3 -->
        <visual name="guard_rail_left_part1_visual">
            <pose>-1.3 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.4 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_left_part1_collision">
            <pose>-1.3 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.4 0.03 0.15</size></box>
            </geometry>
        </collision>

        <!-- Левый бортик: Часть 2 (Центральная) -> Длина = 1.0м, Центр X = 0.0 -->
        <visual name="guard_rail_left_part2_visual">
            <pose>0.0 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>1.0 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_left_part2_collision">
            <pose>0.0 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>1.0 0.03 0.15</size></box>
            </geometry>
        </collision>

        <!-- Левый бортик: Часть 3 (Передняя) -> Длина = 0.4м, Центр X = 1.3 -->
        <visual name="guard_rail_left_part3_visual">
            <pose>1.3 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.4 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_left_part3_collision">
            <pose>1.3 0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.4 0.03 0.15</size></box>
            </geometry>
        </collision>


        <!-- БОРТИК 2 (ПРАВЫЙ — ВЫРЕЗЫ ПО 85 СМ, СМЕЩЕННЫЕ НАЗАД) -->
        <!-- Вырез 1: от -1.35 до -0.5. Вырез 2: от 0.25 до 1.1 -->
        <!-- Правый бортик делится на 3 части: -->
        <!-- Часть 1 (Задняя): от -1.5 до -1.35. Длина = 0.15м. Центр X = -1.425 -->
        <!-- Часть 2 (Средняя): от -0.5 до 0.25. Длина = 0.75м. Центр X = -0.125 -->
        <!-- Часть 3 (Передняя): от 1.1 до 1.5. Длина = 0.40м. Центр X = 1.3 -->

        <!-- Правый бортик: Часть 1 -->
        <visual name="guard_rail_right_part1_visual">
            <pose>-1.425 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.15 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_right_part1_collision">
            <pose>-1.425 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.15 0.03 0.15</size></box>
            </geometry>
        </collision>

        <!-- Правый бортик: Часть 2 (Центральная) -->
        <visual name="guard_rail_right_part2_visual">
            <pose>-0.125 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.75 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_right_part2_collision">
            <pose>-0.125 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.75 0.03 0.15</size></box>
            </geometry>
        </collision>

        <!-- Правый бортик: Часть 3 -->
        <visual name="guard_rail_right_part3_visual">
            <pose>1.3 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.4 0.03 0.15</size></box>
            </geometry>
            <material>
                <ambient>0.3 0.3 0.3 1</ambient>
                <diffuse>0.3 0.3 0.3 1</diffuse>
            </material>
        </visual>
        <collision name="guard_rail_right_part3_collision">
            <pose>1.3 -0.265 0.05 0 0 0</pose>
            <geometry>
                <box><size>0.4 0.03 0.15</size></box>
            </geometry>
        </collision>


        <!-- НОЖКА 1 (Передняя левая) -->
        <visual name="leg_fl_visual">
            <pose>1.35 0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
            </material>
        </visual>
        <collision name="leg_fl_collision">
            <pose>1.35 0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
        </collision>

        <!-- НОЖКА 2 (Передняя правая) -->
        <visual name="leg_fr_visual">
            <pose>1.35 -0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
            </material>
        </visual>
        <collision name="leg_fr_collision">
            <pose>1.35 -0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
        </collision>

        <!-- НОЖКА 3 (Задняя левая) -->
        <visual name="leg_bl_visual">
            <pose>-1.35 0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
            </material>
        </visual>
        <collision name="leg_bl_collision">
            <pose>-1.35 0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
        </collision>

        <!-- НОЖКА 4 (Задняя правая) -->
        <visual name="leg_br_visual">
            <pose>-1.35 -0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.2 0.2 0.2 1</ambient>
                <diffuse>0.2 0.2 0.2 1</diffuse>
            </material>
        </visual>
        <collision name="leg_br_collision">
            <pose>-1.35 -0.23 -0.35 0 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.03</radius>
                    <length>0.6</length>
                </cylinder>
            </geometry>
        </collision>
    </link>

    <!-- Плагин управления треком -->
    <plugin
        filename="gz-sim-track-controller-system"
        name="gz::sim::systems::TrackController">
        <link>belt_link</link>
        <min_velocity>-10.0</min_velocity>
        <max_velocity>10.0</max_velocity>
        <velocity_topic>/tape_speed</velocity_topic> 
    </plugin>
</model>
</sdf>

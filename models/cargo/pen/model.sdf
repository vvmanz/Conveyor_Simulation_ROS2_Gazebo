<?xml version="1.0"?>
<sdf version="1.6">
  <model name="pen">
    <static>false</static> 
    <link name="link">

    <inertial>
      <!-- Центр масс совпадает с центром коллизии ручки -->
      <pose>0 0 0 0 0 0</pose>
      <!-- Реалистичная масса ручки (15 грамм) -->
      <mass>0.015</mass>
      <!-- Рассчитанный тензор инерции для тонкого цилиндра -->
      <inertia>
        <ixx>2.822e-05</ixx>
        <ixy>0.0</ixy>
        <ixz>0.0</ixz>
        <iyy>2.822e-05</iyy>
        <iyz>0.0</iyz>
        <izz>1.875e-07</izz>
      </inertia>
    </inertial>

      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.005</radius>
            <length>0.15</length> 
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <pose>-0.04 -0.095 -0.125 0 0 0</pose> 
        <geometry>
          <mesh>
            <uri>model://pen/pen.stl</uri>
            <scale>0.001 0.001 0.001</scale> 
          </mesh>
        </geometry>
        <material>
          <ambient>COLOR_MARKER</ambient>
          <diffuse>COLOR_MARKER</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>

<?xml version="1.0"?>
<sdf version="1.6">
  <model name="bottle">
    <static>false</static> 
    <link name="link">

      <!-- МАССА И ИНЕРЦИЯ: Смещение 0.12 по Y строго совпадает с физическим телом -->
      <inertial>
        <pose>0 0.15 0 1.5708 0 0</pose> 
        <mass>0.5</mass> 
        <inertia>
          <ixx>0.001867</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.000400</iyy>
          <iyz>0.0</iyz>
          <izz>0.001867</izz>
        </inertia>
      </inertial>

      <!-- КОЛЛИЗИЯ: Физический цилиндр смещен на 12 см по Y и уложен на бок -->
      <collision name="collision">
        <pose>0 0.15 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.3</length> 
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- ВИЗУАЛИЗАЦИЯ: Меш смещен на те же 12 см по Y. Повороты выставлены в 0, -->
      <!-- так как изначально в STL-файле бутылка уже лежит горизонтально. -->
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose> 
        <geometry>
          <mesh>
            <uri>model://bottle/bottle.stl</uri>
            <scale>0.001 0.001 0.001</scale> 
          </mesh>
        </geometry>
        <material>
          <ambient>COLOR_MARKER</ambient>
          <diffuse>COLOR_MARKER</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>

    </link>
  </model>
</sdf>

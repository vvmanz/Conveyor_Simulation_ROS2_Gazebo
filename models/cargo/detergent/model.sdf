        <geometry>
          <cylinder>
            <radius>0.02</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>-0.1625 0.085 -0.1 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://detergent/detergent.stl</uri>
            <scale>0.001 0.001 0.001</scale> 

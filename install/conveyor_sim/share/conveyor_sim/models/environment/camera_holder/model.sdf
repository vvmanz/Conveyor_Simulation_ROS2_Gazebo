<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="camera_holder">
    <static>true</static>
    <link name="mount_link">
      <visual name="pole_visual">
        <pose>0 0 0.825 0 0 0</pose>   <!-- центр на высоте 0.8 м от основания -->
        <geometry>
          <box>
            <size>0.02 0.04 1.65</size>  <!-- высота 1.6 м, толщина 4 см -->
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <visual name="holder_visual">
        <pose>0 -0.15 1.65 0 0 0</pose>   <!-- центр на высоте 0.8 м от основания -->
        <geometry>
          <box>
            <size>0.04 0.3 0.02</size>  <!-- высота 1.6 м, толщина 4 см -->
          </box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>   

    </link>
  </model>
</sdf>
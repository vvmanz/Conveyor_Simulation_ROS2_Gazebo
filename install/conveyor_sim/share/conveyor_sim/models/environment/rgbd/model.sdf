<?xml version="1.0" ?>
<sdf version="1.10">

<model name="rgbd">
    <static>true</static>
    <link name="camera_link">
        <visual name="body_visual">
            <pose>0 0 0 1.5708 0 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.025</radius>
                    <length>0.14</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.15 0.15 0.15 1</ambient>
                <diffuse>0.15 0.15 0.15 1</diffuse>
            </material>
        </visual>
        <visual name="lens_left_visual">
            <pose>0.023 0.035 0 0 1.5708 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.012</radius>
                    <length>0.006</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.05 0.05 0.1 1</ambient>
                <diffuse>0.05 0.05 0.2 1</diffuse> 
            </material>
        </visual>
        <visual name="lens_right_visual">
            <pose>0.023 -0.035 0 0 1.5708 0</pose>
            <geometry>
                <cylinder>
                    <radius>0.012</radius>
                    <length>0.006</length>
                </cylinder>
            </geometry>
            <material>
                <ambient>0.05 0.05 0.1 1</ambient>
                <diffuse>0.05 0.05 0.2 1</diffuse>
            </material>
        </visual>

        <visual name="mount_visual">
            <pose>-0.01 0 -0.04 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.03 0.03 0.04</size>
                </box>
            </geometry>
            <material>
                <ambient>0.25 0.25 0.25 1</ambient>
                <diffuse>0.25 0.25 0.25 1</diffuse>
            </material>
        </visual>

        <collision name="camera_collision">
            <pose>0.005 0 -0.01 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.06 0.15 0.1</size>
                </box>
            </geometry>
        </collision>

        <sensor name="rgbd_sensor" type="rgbd_camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <camera>
                <horizontal_fov>1.467</horizontal_fov>
                <image>
                    <width>1280</width>
                    <height>720</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>6.0</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.2</near>
                        <far>6.0</far>
                    </clip>
                </depth_camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.005</stddev>
                </noise>
            </camera>
        </sensor>
    </link>
</model>
</sdf>

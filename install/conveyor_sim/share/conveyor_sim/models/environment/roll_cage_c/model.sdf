<?xml version="1.0" ?>
<sdf version="1.10">
<model name="roll_cage_c">
    <static>true</static> <!-- Сделайте true, если он должен стоять намертво -->
    
    <link name="base_link">
        <!-- Физические свойства (масса и инерция) -->
        <inertial>
            <pose>0 0 0.3 0 0 0</pose>
            <mass>25.0</mass>
            <inertia>
                <ixx>2.66</ixx>
                <ixy>0.0</ixy>
                <ixz>0.0</ixz>
                <iyy>4.33</iyy>
                <iyz>0.0</iyz>
                <izz>5.66</izz>
            </inertia>
        </inertial>

        <!-- ==================== ОСНОВАНИЕ (ПОДДОН) ==================== -->
        <visual name="base_visual">
            <pose>0 0 0.1 0 0 0</pose>
            <geometry>
                <box><size>1.2 0.8 0.05</size></box>
            </geometry>
            <material>
                <ambient>0.0 0.2 0.6 1.0</ambient> <!-- Насыщенный синий -->
                <diffuse>0.0 0.3 0.8 1.0</diffuse>
            </material>
        </visual>
        <collision name="base_collision">
            <pose>0 0 0.1 0 0 0</pose>
            <geometry>
                <box><size>1.2 0.8 0.05</size></box>
            </geometry>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>1.0</mu2>
                    </ode>
                </friction>
            </surface>
        </collision>

        <!-- ==================== УГЛОВЫЕ СТОЙКИ ==================== -->
        <!-- Передняя левая -->
        <visual name="post_fl">
            <pose>0.58 0.38 0.45 0 0 0</pose>
            <geometry><cylinder><radius>0.015</radius><length>0.7</length></cylinder></geometry>
            <material><ambient>0.0 0.3 0.8 1</ambient><diffuse>0.0 0.3 0.8 1</diffuse></material>
        </visual>
        <!-- Передняя правая -->
        <visual name="post_fr">
            <pose>0.58 -0.38 0.45 0 0 0</pose>
            <geometry><cylinder><radius>0.015</radius><length>0.7</length></cylinder></geometry>
            <material><ambient>0.0 0.3 0.8 1</ambient><diffuse>0.0 0.3 0.8 1</diffuse></material>
        </visual>
        <!-- Задняя левая -->
        <visual name="post_bl">
            <pose>-0.58 0.38 0.45 0 0 0</pose>
            <geometry><cylinder><radius>0.015</radius><length>0.7</length></cylinder></geometry>
            <material><ambient>0.0 0.3 0.8 1</ambient><diffuse>0.0 0.3 0.8 1</diffuse></material>
        </visual>
        <!-- Задняя правая -->
        <visual name="post_br">
            <pose>-0.58 -0.38 0.45 0 0 0</pose>
            <geometry><cylinder><radius>0.015</radius><length>0.7</length></cylinder></geometry>
            <material><ambient>0.0 0.3 0.8 1</ambient><diffuse>0.0 0.3 0.8 1</diffuse></material>
        </visual>

        <!-- ==================== СТЕНКИ (КОЛЛИЗИИ) ==================== -->
        <!-- Защитные невидимые коллизии стенок, чтобы груз не вываливался -->
        <collision name="wall_left_collision"><pose>0 0.38 0.45 0 0 0</pose><geometry><box><size>1.2 0.02 0.7</size></box></geometry></collision>
        <collision name="wall_right_collision"><pose>0 -0.38 0.45 0 0 0</pose><geometry><box><size>1.2 0.02 0.7</size></box></geometry></collision>
        <collision name="wall_back_collision"><pose>-0.58 0 0.45 0 0 0</pose><geometry><box><size>0.02 0.8 0.7</size></box></geometry></collision>
        <collision name="wall_front_collision"><pose>0.58 0 0.45 0 0 0</pose><geometry><box><size>0.02 0.8 0.7</size></box></geometry></collision>

        <!-- ==================== СЕТКА ДЛЯ ВИЗУАЛА (Примеры прутьев) ==================== -->
        <!-- Левая сторона: Горизонтальные ребра -->
        <visual name="wire_l1"><pose>0 0.38 0.3 0 1.5708 0</pose><geometry><cylinder><radius>0.005</radius><length>1.16</length></cylinder></geometry></visual>
        <visual name="wire_l2"><pose>0 0.38 0.5 0 1.5708 0</pose><geometry><cylinder><radius>0.005</radius><length>1.16</length></cylinder></geometry></visual>
        <visual name="wire_l3"><pose>0 0.38 0.7 0 1.5708 0</pose><geometry><cylinder><radius>0.005</radius><length>1.16</length></cylinder></geometry></visual>

        <!-- Правая сторона: Горизонтальные ребра -->
        <visual name="wire_r1"><pose>0 -0.38 0.3 0 1.5708 0</pose><geometry><cylinder><radius>0.005</radius><length>1.16</length></cylinder></geometry></visual>
        <visual name="wire_r2"><pose>0 -0.38 0.5 0 1.5708 0</pose><geometry><cylinder><radius>0.005</radius><length>1.16</length></cylinder></geometry></visual>
        <visual name="wire_r3"><pose>0 -0.38 0.7 0 1.5708 0</pose><geometry><cylinder><radius>0.005</radius><length>1.16</length></cylinder></geometry></visual>

        <!-- Задняя сторона: Горизонтальные ребра -->
        <visual name="wire_b1"><pose>-0.58 0 0.3 1.5708 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.76</length></cylinder></geometry></visual>
        <visual name="wire_b2"><pose>-0.58 0 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.76</length></cylinder></geometry></visual>
        <visual name="wire_b3"><pose>-0.58 0 0.7 1.5708 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.76</length></cylinder></geometry></visual>

        <!-- Передняя сторона (Дверца): Горизонтальные ребра -->
        <visual name="wire_f1"><pose>0.58 0 0.3 1.5708 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.76</length></cylinder></geometry></visual>
        <visual name="wire_f2"><pose>0.58 0 0.5 1.5708 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.76</length></cylinder></geometry></visual>
        <visual name="wire_f3"><pose>0.58 0 0.7 1.5708 0 0</pose><geometry><cylinder><radius>0.005</radius><length>0.76</length></cylinder></geometry></visual>

        <!-- ==================== КОЛЕСА СНИЗУ = ==================== -->
        <visual name="wheel_fl"><pose>0.45 0.28 0.04 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="wheel_fr"><pose>0.45 -0.28 0.04 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="wheel_bl"><pose>-0.45 0.28 0.04 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
        <visual name="wheel_br"><pose>-0.45 -0.28 0.04 1.5708 0 0</pose><geometry><cylinder><radius>0.04</radius><length>0.03</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>

        <!-- Коллизия колес (упрощенная общая плоскость снизу для стабильности физики) -->
        <collision name="wheels_collision">
            <pose>0 0 0.04 0 0 0</pose>
            <geometry><box><size>1.0 0.6 0.08</size></box></geometry>
        </collision>
    </link>
</model>
</sdf>

<?xml version="1.0"?>
<sdf version="1.10">
<world name="conveyor_world">
    <physics name='10ms' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>30</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
</plugin>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
        <cast_shadows>false</cast_shadows>
        <pose>0 0 10 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!--<include>
        <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>-->

    <include>
        <uri>model://main_zone</uri>
        <pose>0 0 0.001 0 0 0</pose>
    </include>
    
    <include>
        <uri>model://conveyor</uri>
        <name>conveyor_zone_A</name> <!-- Переопределяем имя -->
        <pose>0 2.75 0.65 0 0 1.5708</pose>
    </include>

    <include>
        <uri>model://conveyor_zone_b</uri>
        <name>conveyor_zone_B</name> <!-- Переопределяем имя -->
        <pose>2.25 -1.6 0.65 0 0 0</pose>
    </include>

    <include>
        <uri>model://conveyor_to_sorter_b</uri>
        <name>conveyor_to_sorter_b</name> <!-- Переопределяем имя -->
        <pose>0.65 -1.6 0.65 0 0 0</pose>
    </include>

    <include>
        <uri>model://roll_tape</uri>
        <name>roll_tape</name> 
        <pose>0 0.15 0.65 0 0 1.5708</pose>
    </include>

    <include>
        <uri>model://inclined_conveyor_c</uri>
        <name>inclined_conveyor_c</name> 
        <pose>-0.6275 0.895 0.7 0 0 0</pose>
    </include>

    <include>
        <uri>model://inclined_conveyor_d</uri>
        <name>inclined_conveyor_d</name> 
        <pose>-0.6275 -0.67 0.7 0 0 0</pose>
    </include>

    <include>
        <uri>model://pusher_1</uri>
        <name>pusher_1</name> 
        <pose>0.265 1.2 0.76 0 0 -1.5708</pose>
    </include>

    <include>
        <uri>model://pusher_2</uri>
        <name>pusher_2</name> 
        <pose>0.265 -0.4 0.76 0 0 -1.5708</pose>
    </include>





    <!-- <include>
        <uri>model://sorter_hopper</uri>
        <pose>10 0.001 0.65 0 0 1.5708</pose>
    </include> -->

    <include>
        <uri>model://rgbd</uri>
        <pose>0 2.15 1.65 0 1.5708 1.5708</pose>
    </include>

    <include>
        <uri>model://camera_holder</uri>   <!-- ваш новый SDF -->
        <pose>0.3 2.1 0 0 0 -1.5708</pose>
    </include>

    <include>
        <uri>model://roll_cage_c</uri>   
        <pose>-1.4 -0.75 0 0 0 -1.5708</pose>
    </include>

    <include>
        <uri>model://roll_cage_d</uri>   
        <pose>-1.4 0.6 0 0 0 -1.5708</pose>
    </include>
</world>
</sdf>